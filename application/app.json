{
  "expo": {
    "name": "Bethel AG",
    "slug": "bethel-ag",
    "scheme": "bethelag",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/logoicon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "jsEngine": "hermes",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification.png",
          "color": "#667eea"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bethelag.dubai",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses your camera to upload images.",
        "NSPhotoLibraryUsageDescription": "This app uses your photo library to upload images.",
        "NSPhotoLibraryAddOnlyUsageDescription": "This app needs to save photos to your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoicon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.bethelag.dubai",
      "versionCode": 6,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "name": "Bethel AG Dubai",
      "shortName": "Bethel AG",
      "theme_color": "#667eea",
      "background_color": "#1a1a2e",
      "display": "standalone",
      "scope": "/",
      "start_url": "/",
      "orientation": "portrait-primary"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/bbda3eb2-5866-4799-9cf1-7c29f383efde"
    },
    "description": "Bethel AG Dubai - A modern platform for community and commerce.",
    "extra": {
      "eas": {
        "projectId": "bbda3eb2-5866-4799-9cf1-7c29f383efde"
      },
      "apiUrl": "https://bethel-ag-qvtu.onrender.com/api",
      "appVersion": "1.0.0"
    },
    "owner": "johnsmatz"
  }
}